# Copiar a .env.production para builds de produccion
# Vite inyecta estas variables al build (no se exponen al runtime)
#
# OBLIGATORIAS (Diego, 22/10/2026). `scripts/entornoDeProduccion.js` para el
# `vite build` de produccion si falta cualquiera de las variables de este
# fichero. El 22/10 se compilo en un worktree sin `.env.production` y salio a
# produccion sin el ranking de gestoras ni el resto del proceso de ventas, sin
# que nadie se enterase. Si se añade una variable al `.env.production`, se
# añade tambien aqui.

VITE_API_URL=https://crm.iseie.com/api
VITE_BETA_MODE=true

# WhatsApp esta en revision: viaja en el build pero no se enseña en produccion.
# Se quita esta linea y se recompila el dia que se encienda.
VITE_MODULOS_APAGADOS=

# El proceso comercial (pestaña Proceso, agenda, Seguimiento de fin de mes,
# Feedback, Novedades…). Es el valor que llevo produccion del 29/09 al 21/10
# («toda la 2.0.0», Diego, 29/09/2026). Lo que valga lo decide Diego; tiene que
# estar PUESTA. Desde el 22/10 el ranking de gestoras («Como voy») ya no
# depende de ella.
VITE_PROCESO_EN_PRUEBAS=true

# Diplomas y Certificaciones de Certifex en el menú. El build se para si falta:
# el 29/10 se compilaron cuatro versiones sin ella y Diplomas desapareció del menú.
VITE_CERTIFEX_PANEL=1
