# /etc/crm-copias/copias.env (root:root 600) - configuración de la copia diaria (#634, CRM-ISEIE#361).
# Ejemplo de ISEIE: solo el Postgres del VPS (sin Docker ni SQLite). En el 360 son
# COPIAS_BASES="crm_prod_db crm_test_db" y COPIAS_DIR=/var/backups/crm/base.
COPIAS_BASES="crm_iseie crm_iseie_staging"
COPIAS_DOCKER_PG=
COPIAS_SQLITE=
COPIAS_DIR=/var/backups/crm-iseie/base
COPIAS_DIARIAS=7
COPIAS_SEMANALES=4
COPIAS_MIN_LIBRE_MB=2048
# Fuera del VPS (rclone configurado como root). Vacío = solo en este disco.
COPIAS_REMOTO=
