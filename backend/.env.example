# ========================
# Server
# ========================
NODE_ENV=development
PORT=3005
CORS_ORIGINS=http://localhost:5173

# ========================
# Database
# ========================
# Nota: ya existe un crm_iseie ajeno (académico) en el VPS. Para nuestro
# proyecto usamos crm_iseie + rol crm_iseie_user (sufijo crm_ para distinguir
# del iseie_user del académico).
DATABASE_URL=postgresql://crm_iseie_user:password@localhost:5432/crm_iseie

# ========================
# JWT (access token de 8h firmado con HS256)
# ========================
JWT_SECRET=your-jwt-secret-here

# JWT refresh secret (separado del access). Usado por auth.service para
# firmar el refresh token de 30 días que viaja en cookie httpOnly.
# Generar con: openssl rand -hex 32
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# ========================
# Cifrado AES-256-GCM de credenciales API (módulo `credentials`)
# Clave de 32 bytes (64 chars hex). Generar con: openssl rand -hex 32
# ========================
ENCRYPTION_KEY=

# ========================
# Cookies (refresh token httpOnly)
# COOKIE_SECURE=true SOLO con HTTPS. En beta sobre HTTP dejar false.
# ========================
COOKIE_SECURE=false

# ========================
# Base URL del frontend (para links en emails de welcome/set-password)
# ========================
CRM_BASE_URL=http://localhost:5173

# ========================
# Local uploads dir (avatares, logos). Default produccion: /var/crm-iseie-uploads
# ========================
UPLOADS_DIR=

# ========================
# Brevo (email transaccional)
# ========================
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@iseie.local
BREVO_FROM_NAME=CRM ISEIE

# ========================
# Cloudflare R2 (storage de documentos, logos, dossiers)
# Si no se configuran, los uploads van a UPLOADS_DIR local.
# ========================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ========================
# Google Ads / Search Console (OAuth)
# Solo si se conecta el conector Google Ads / GSC desde Settings → Integraciones.
# ========================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ========================
# Schedulers (cron jobs). Poner =1 para deshabilitar.
# Ticks configurables en ms.
# ========================
EMAIL_SEQ_DISABLED=
EMAIL_SEQ_TICK_MS=120000
REMINDER_DISABLED=
REMINDER_TICK_MS=300000
DOC_ORPHAN_DISABLED=
WC_SYNC_DISABLED=
GOOGLE_ADS_TOKEN_DISABLED=

# ========================
# Logging
# ========================
LOG_LEVEL=info

# ── WhatsApp ─────────────────────────────────────────────────────────────────
#
# El CRM habla con un servicio que expone los endpoints de Evolution API. En los
# dos servidores hay Evolution en Docker; en local se puede usar un puente con
# Baileys que imita esos mismos endpoints, porque Docker no arranca en todas las
# maquinas. El CRM no distingue cual de los dos hay detras.
#
# Sin EVOLUTION_URL y EVOLUTION_API_KEY el modulo se queda inerte y lo avisa —no
# rompe nada—, porque comprueba si esta configurado antes de llamar.

# Donde escucha. Escucha SOLO en 127.0.0.1: no se expone al exterior.
# Aqui el 8080 lo ocupa Nginx, asi que Evolution va por el 8081.
EVOLUTION_URL=http://127.0.0.1:8081

# La clave que protege Evolution. NO se pide a nadie: te la inventas y la pones
# igual en los dos sitios — aqui y en AUTHENTICATION_API_KEY del compose.
#   openssl rand -hex 32
EVOLUTION_API_KEY=

# Prefijo de las sesiones. Cada usuario tiene la suya: crm-u7, crm-u12...
# El id del usuario va dentro del nombre, y de ahi sale el aislamiento.
#
# CAMBIALO EN CADA ENTORNO. Si pruebas y produccion comparten prefijo, comparten
# sesiones: alguien probando en /testeo DESCONECTA el WhatsApp de una gestora
# que esta trabajando. En produccion «crm», en pruebas «testeo».
EVOLUTION_INSTANCIA=crm

# A DONDE AVISA EVOLUTION cuando entra un mensaje de una sesion de este entorno.
#
# Vacio = se usa el webhook global del contenedor, que apunta a un solo sitio; y
# entonces los mensajes de pruebas acaban en la base de produccion. Ponla siempre
# que haya mas de un entorno contra el mismo Evolution.
#   http://172.17.0.1:3002/api/whatsapp/webhook?s=EL_MISMO_SECRETO
EVOLUTION_WEBHOOK_URL=

# OBLIGATORIO en produccion: sin el, el webhook responde 503 y no procesa nada.
#
# Esa ruta va ANTES del verifyToken —la llama el contenedor, no un navegador—,
# asi que dejarlo vacio permitiria a cualquiera que supiera la direccion meter
# mensajes inventados en la conversacion de una gestora.
#
# Se acepta en la cabecera x-webhook-secret o dentro de la propia direccion: el
# webhook GLOBAL de Evolution no deja mandar cabeceras propias, y con el secreto
# solo por cabecera habria rechazado TODOS los mensajes entrantes.
#   openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=

# Los frenos que protegen el numero. Lo que hace que WhatsApp suspenda una linea
# no es tanto detectar el cliente como que la gente la bloquee y la reporte, asi
# que estos numeros son conservadores a proposito. Son POR NUMERO.
WA_TOPE_MINUTO=6
WA_TOPE_HORA=60
WA_TOPE_DIA=300
WA_PAUSA_MS=1500

# Cuantos dias de historial de adjuntos se bajan solos al enlazar. Lo de ahora se
# baja siempre y con prioridad; lo mas viejo sale como «Descargar» en el chat.
# Sin tope, un movil de anos mete 17.000 archivos en la cola y lo que envias se
# pone detras de todos.
WA_MEDIA_DIAS=30

# Los adjuntos ya descargados van donde diga UPLOADS_DIR, definido mas arriba.
# En este servidor tiene que apuntar a un sitio con espacio: un movil de anos
# baja miles de archivos al enlazar.

# El freno de escribir a desconocidos. VIENE APAGADO — decision de Diego,
# 21/08/2026.
#
# Impedia el primer mensaje a un numero que no fuera prospecto y que nunca
# hubiera escrito. No evitaba nada: la gestora escribia igual desde su movil,
# pero sin registro, sin plantilla y sin los topes de ritmo de arriba.
#
# Escribir a quien no pidio informacion sigue siendo lo que hace que reporten un
# numero, asi que queda apuntado en el registro. El freno ahora es saberlo, no
# impedirlo. Para volver a frenar, true — pero eso se habla antes con Diego.
#
# La variable vieja se llamaba WA_EXIGIR_CONSENTIMIENTO y significaba lo
# CONTRARIO. Si sigue en algun .env, el servidor la ignora y lo avisa al
# arrancar; quitala.
WA_BLOQUEO_DESCONOCIDOS=false
EMAIL_LISTA_BLANCA=
LEAD_SIN_TOCAR_MINUTOS=30
LEAD_SIN_TOCAR_TICK_MS=300000
WHATSAPP_GRUPOS=si
