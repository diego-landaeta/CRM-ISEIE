# ========================
# Server
# ========================
NODE_ENV=development
PORT=3005
CORS_ORIGINS=http://localhost:5173

# ========================
# Database
# ========================
# Nota: ya existe un crm_iseie ajeno (académico) en el VPS. Para nuestro
# proyecto usamos crm_iseie + rol crm_iseie_user (sufijo crm_ para distinguir
# del iseie_user del académico).
DATABASE_URL=postgresql://crm_iseie_user:password@localhost:5432/crm_iseie

# ========================
# JWT (access token de 8h firmado con HS256)
# ========================
JWT_SECRET=your-jwt-secret-here

# JWT refresh secret (separado del access). Usado por auth.service para
# firmar el refresh token de 30 días que viaja en cookie httpOnly.
# Generar con: openssl rand -hex 32
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# ========================
# Cifrado AES-256-GCM de credenciales API (módulo `credentials`)
# Clave de 32 bytes (64 chars hex). Generar con: openssl rand -hex 32
# ========================
ENCRYPTION_KEY=

# ========================
# Cookies (refresh token httpOnly)
# COOKIE_SECURE=true SOLO con HTTPS. En beta sobre HTTP dejar false.
# ========================
COOKIE_SECURE=false

# ========================
# Base URL del frontend (para links en emails de welcome/set-password)
# ========================
CRM_BASE_URL=http://localhost:5173

# ========================
# Local uploads dir (avatares, logos). Default produccion: /var/crm-iseie-uploads
# ========================
UPLOADS_DIR=

# ========================
# Brevo (email transaccional)
# ========================
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@iseie.local
BREVO_FROM_NAME=CRM ISEIE

# ========================
# Cloudflare R2 (storage de documentos, logos, dossiers)
# Si no se configuran, los uploads van a UPLOADS_DIR local.
# ========================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ========================
# Google Ads / Search Console (OAuth)
# Solo si se conecta el conector Google Ads / GSC desde Settings → Integraciones.
# ========================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ========================
# Schedulers (cron jobs). Poner =1 para deshabilitar.
# Ticks configurables en ms.
# ========================
EMAIL_SEQ_DISABLED=
EMAIL_SEQ_TICK_MS=120000
REMINDER_DISABLED=
REMINDER_TICK_MS=300000
DOC_ORPHAN_DISABLED=
WC_SYNC_DISABLED=
GOOGLE_ADS_TOKEN_DISABLED=

# ========================
# Logging
# ========================
LOG_LEVEL=info
