    users {
        int id PK
        varchar email UK
        varchar nombre
        enum role "superadmin/admin/gestor"
        bool active
    }

    projects {
        int id PK
        varchar nombre
        varchar slug UK
        varchar logo_url
        varchar producto_label "ej Formacion"
        varchar webhook_api_key
        bool active
    }

    leads {
        int id PK
        int project_id FK
        int responsable_id FK
        int producto_interes_id FK
        varchar email
        enum status
        enum canal
        bool reincidente
        jsonb custom_fields
    }

    products {
        int id PK
        int project_id FK
        int categoria_id FK
        varchar nombre
        decimal precio
        varchar moneda
        varchar stripe_link
        varchar sku
    }

    product_categories {
        int id PK
        int project_id FK
        int parent_id FK
        varchar nombre
        int orden
    }

    conversions {
        int id PK
        int lead_id FK
        int producto_contratado_id FK
        decimal importe_total
        decimal importe_pagado
        date fecha_compromiso_pago
    }

    conversion_payments {
        int id PK
        int conversion_id FK
        decimal importe
        date fecha
    }

    commission_rules {
        int id PK
        int user_id FK
        int product_id FK
        decimal pct "0-100"
    }

    commissions {
        int id PK
        int conversion_id FK UK
        int user_id FK
        decimal importe_base
        decimal pct
        decimal importe_comision
        enum estado
    }

    expenses {
        int id PK
        int project_id FK
        decimal importe
        enum categoria
    }

    accounts_payable {
        int id PK
        int project_id FK
        varchar proveedor
        decimal importe_total
        decimal importe_pagado
        enum estado
    }

    accounts_payable_payments {
        int id PK
        int payable_id FK
        decimal importe
    }

    project_field_definitions {
        int id PK
        int project_id FK
        varchar field_key
        enum type
        bool required
    }

    api_credentials {
        int id PK
        int project_id FK
        varchar service
        bytea encrypted_value
    }

    dossiers {
        int id PK
        int product_id FK
        varchar key
        int version
    }

    lead_interactions {
        int id PK
        int lead_id FK
        enum tipo
        text nota
    }

    lead_reminders {
        int id PK
        int lead_id FK
        timestamp fecha
        bool completado
    }

    lead_utms {
        int id PK
        int lead_id FK
        varchar utm_source
        varchar utm_campaign
    }

    project_queue_state {
        int project_id PK
        int next_index
    }
