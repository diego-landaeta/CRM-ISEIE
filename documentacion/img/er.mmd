    projects ||--o{ leads : "contiene"
    projects ||--o{ products : "ofrece"
    projects ||--o{ product_categories : "define"
    projects ||--o{ expenses : "registra"
    projects ||--o{ accounts_payable : "debe"
    projects ||--|| project_queue_state : "cola RR"
    projects ||--o{ project_field_definitions : "campos"

    leads ||--o{ lead_interactions : "tiene"
    leads ||--o{ lead_reminders : "tiene"
    leads ||--o{ lead_status_history : "audita"
    leads ||--|| lead_utms : "tiene"
    leads }o--|| leads : "duplicado_de"
    leads ||--o{ conversions : "convierte"

    products ||--o{ dossiers : "tiene PDF"
    products ||--o{ leads : "interes"
    products ||--o{ conversions : "vende"
    products ||--o{ commission_rules : "scope"
    products }o--|| product_categories : "categoria"
    products }o--|| product_categories : "subcategoria"
    product_categories ||--o{ product_categories : "padre/hija"

    conversions ||--o{ conversion_payments : "pagos"
    conversions ||--|| commissions : "genera"
    commission_rules ||--o{ commissions : "aplica"

    accounts_payable ||--o{ accounts_payable_payments : "pagos"

